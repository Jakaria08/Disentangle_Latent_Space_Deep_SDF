  "validation_latent_steps": 100,
  "latent_fit": {
    "steps": 500,
    "samples_per_step": 16384,
    "learning_rate": 0.005,
    "code_regularization_lambda": 0.0001,
    "code_bound": 1.0,
    "initial_std": 0.01,
    "holdout_fraction": 0.1,
    "evaluation_samples": 32768,
    "early_stop_patience": 75,
