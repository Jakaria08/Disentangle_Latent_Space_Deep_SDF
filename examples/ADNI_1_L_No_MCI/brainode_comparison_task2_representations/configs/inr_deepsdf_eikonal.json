  "output_dir": "examples/ADNI_1_L_No_MCI/brainode_comparison_task2_representations/inr/deepsdf_eikonal_spec_fast",
  "network_arch": "deep_sdf_decoder",
  "network_specs": {
    "dims": [512, 512, 512, 512, 512, 512, 512, 512],
