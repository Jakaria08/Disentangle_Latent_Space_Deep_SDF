{
  "name": "adni_synthseg_left_lateral_ventricle_pca150_v1_anchored_ad_speed_v4",
  "structure": "left_lateral_ventricle",
  "method": "frozen_v1_anchored_ad_speed_calibration",
  "representation": {
    "components": 150,
    "training_latent_key": "visit_pca_standardized_150",
    "standardization": "train PCA-score mean/std only; V4 calibrates displacement in this fixed space",
    "separate_structure_only": true
  },
  "model": {
    "feature_pcs": 32,
    "hidden_dims": [64, 32],
    "dropout": 0.1,
    "minimum_speed": 0.25,
    "maximum_speed": 4.0,
    "initial_ad_speed": 2.5,
    "individual_log_span": 0.25
  },
  "training": {
    "epochs": 80,
    "batch_size": 128,
    "samples_per_epoch": 1024,
    "sequence_subjects_per_epoch": 160,
    "learning_rate_global": 0.005,
    "learning_rate_head": 0.001,
    "weight_decay": 0.001,
    "gradient_clip_norm": 1.0,
    "warmup_global_epochs": 15,
    "early_stopping_patience": 20,
    "early_stopping_min_delta": 0.000001,
    "seed": 42
  },
  "loss": {
    "pca_weight": 1.0,
    "vertex_weight": 1.0,
    "pair_rate_weight": 0.25,
    "subject_slope_weight": 0.25,
    "group_slope_weight": 0.05,
    "cocycle_weight": 0.1,
    "inverse_weight": 0.05,
    "no_degradation_weight": 1.0,
    "speed_regularization_weight": 0.01,
    "no_degradation_tolerance": 0.005,
    "huber_delta": 1.0
  },
  "selection": {
    "endpoint_tolerance": 0.005,
    "first_last_tolerance": 0.01,
    "volume_relative_error_weight": 0.5,
    "fallback": "exact V1 identity if no calibrated candidate is feasible"
  },
  "scientific_contract": {
    "base_v1_is_frozen": true,
    "cn_speed_is_exactly_one": true,
    "ad_only_calibration": true,
    "volume_direction_is_evaluated_not_hard_constrained": "left lateral ventricle normally expands; individual trajectories may vary",
    "strict_no_mci": true,
    "source_meshes_modified": false
  }
}
