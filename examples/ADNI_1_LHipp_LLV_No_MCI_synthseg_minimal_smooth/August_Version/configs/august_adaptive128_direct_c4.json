{
  "name": "august_adaptive128_direct_c4",
  "representation": "adaptive128",
  "method": "direct_c4",
  "model": {
    "latent_dim": 128,
    "variant": "direct",
    "width": 256,
    "residual_blocks": 2,
    "dropout": 0.3,
    "transport": "Phi(z,s,t,d)=z+(t-s)*phi(z,s,t,d)",
    "ode_used": false,
    "attention_used": false
  },
  "training": {
    "run_name": "august_adaptive128_direct_c4",
    "epochs": 180,
    "batch_size": 8,
    "samples_per_epoch": 4096,
    "decoder_batch_size": 16,
    "learning_rate": 5e-05,
    "minimum_learning_rate": 3e-05,
    "weight_decay": 0.01,
    "gradient_clip_norm": 1.0,
    "consistency_ramp_epochs": 10,
    "anatomy_ramp_epochs": 15,
    "evaluation_batch_size": 16,
    "early_stopping_patience": 40,
    "early_stopping_min_delta": 1e-05,
    "seed": 42,
    "smoke_train_batches": 2,
    "smoke_pair_limit": 16
  },
  "loss": {
    "real_latent_weight": 0.25,
    "real_vertex_weight": 1.0,
    "observed_semigroup_weight": 0.1,
    "virtual_semigroup_weight": 0.1,
    "inverse_weight": 0.05,
    "sequence_latent_weight": 0.0625,
    "sequence_vertex_weight": 0.25,
    "sequence_semigroup_weight": 0.1,
    "volume_weight": 0.1,
    "rate_weight": 0.1,
    "slope_weight": 0.05,
    "group_rate_weight": 0.02,
    "disease_gap_weight": 0.02,
    "coboundary_weight": 0.0
  },
  "selection": {
    "primary": "macro CN/AD first-to-last decoded transport shape ratio",
    "all_pair_shape_weight": 0.2,
    "volume_tiebreak_weight": 0.001,
    "latent_nochange_tolerance": 0.05,
    "coordinate_nochange_tolerance": 0.05,
    "max_relative_semigroup_defect": 0.25,
    "max_relative_inverse_defect": 0.25,
    "test_used_for_selection": false
  },
  "scientific_contract": {
    "direct_c4": true,
    "coboundary_used": false,
    "decoder_frozen": true,
    "decoder_in_optimizer_loss": true,
    "test_loaded_during_training": false
  },
  "provenance": {
    "derived_from": "adaptive128_direct_c4_s42.json (task3_latent_flow_128_v1)",
    "regularisation_rationale": "dropout 0.30 / wd 0.01 / reduced lr from August diagnostic C; all other losses, cocycle transport and semigroup+inverse consistency unchanged",
    "selection_change": "no-change tolerance 0.01 -> 0.05 (a 1% margin gates out nearly every epoch when the achievable gain is ~6%); patience 25 -> 40 and now counted from genuine score improvement rather than last feasible best. Cocycle defect ceilings (0.25) unchanged."
  }
}
